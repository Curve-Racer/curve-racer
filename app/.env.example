# Copy to .env.local and fill in after deploying CurveRacer.sol.
# Game contract address (NEXT_PUBLIC_GAME_ADDRESS) is required for the UI to
# leave the "not deployed" state.
NEXT_PUBLIC_GAME_ADDRESS=0x0000000000000000000000000000000000000000

# The vibe/vibe bonding curve the game prices off. Defaults to the game
# address; set explicitly if the curve is a different address.
NEXT_PUBLIC_CURVE_ADDRESS=0x7bc42e8a2df6070ae7d1ca720cd5408e8354fc20

# RPC endpoint for Robinhood Chain Testnet (chainId 46630).
NEXT_PUBLIC_RPC_URL=https://robinhood-testnet.drpc.org
